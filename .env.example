# RECOSA — local environment variables
#
# Copy this file to `.env` and fill in real values (pull them from the
# Streamlit Cloud app's "Secrets" panel — same values, .env format instead
# of TOML). `.env` is gitignored and must never be committed.
#
# Run `streamlit run app.py` (client app) or `streamlit run admin_app.py`
# (admin BO) after this is filled in. Standalone scripts (monitor.py,
# monitor_marketing.py) also read this file.

# ── Supabase (required) ─────────────────────────────────────────
SUPABASE_URL=
SUPABASE_KEY=
# Service-role key — used for admin-only operations (storage, monitoring
# writes). Falls back to SUPABASE_KEY if unset.
SUPABASE_SERVICE_KEY=

# ── Mistral (required for chat, monitoring, document AI features) ──
MISTRAL_API_KEY=
# Only needed for the marketing monitor's Premium Search agent.
MISTRAL_AGENT_ID=

# ── Qdrant vector store (required for knowledge-base / RAG features) ──
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=regulations

# ── Brevo email (optional — only needed to test outbound email) ────
BREVO_API_KEY=
BREVO_FROM_EMAIL=audit@complai.be
BREVO_FROM_NAME=COMPLAI Audit
# Base URL used to build links inside outgoing emails.
APP_BASE_URL=http://localhost:8501

# ── Feature flags / misc (optional — sensible defaults if unset) ───
# Set to "true" to actually send client notification emails locally.
NOTIFY_ENABLED=false
# "beta" | "standard"
FEEDBACK_MODE=beta
SUPERSEDED_RETENTION_YEARS=5
