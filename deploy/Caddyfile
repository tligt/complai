# Public names (S50). Caddy obtains and renews the TLS certificates itself
# (Let's Encrypt), once DNS points at the instance. Streamlit's websocket is
# proxied as-is — reverse_proxy handles the upgrade.
{
	email {$ACME_EMAIL}
}

# Client app
{$APP_HOST} {
	encode gzip
	reverse_proxy app:8501
}

# Admin back-office. An extra lock in front of the app's own admin login:
# only the addresses in ADMIN_ALLOWED_IPS get through.
{$ADMIN_HOST} {
	@blocked not remote_ip {$ADMIN_ALLOWED_IPS}
	respond @blocked "Not found" 404
	encode gzip
	reverse_proxy admin:8502
}

# Public free check (was recosa-checklist.streamlit.app)
{$QUIZ_HOST} {
	encode gzip
	reverse_proxy quiz:8503
}

# Supabase API. Only what RECOSA uses is routed — auth, data and files for the
# apps, and the Compliance Pulse function the recosa.eu site reads (S19/S20).
# Everything else Kong serves, Studio in particular, is not reachable from
# outside (use an SSH tunnel to 127.0.0.1:8000, see the runbook).
{$API_HOST} {
	@api path /auth/v1/* /rest/v1/* /storage/v1/* /functions/v1/compliance-pulse*
	handle @api {
		reverse_proxy kong:8000
	}
	handle {
		respond "Not found" 404
	}
}
