# RECOSA production settings (S50). Copy to deploy/.env on the server and fill
# in. Never commit the filled-in file (.env is gitignored).
#
# Read by: the app containers (env_file), Caddy (host names), and
# supabase_env.py, which writes the Supabase stack's own .env from the
# values marked [supabase] below.

# ── Public names ─────────────────────────────────────────────────────────
# One A record per name, all pointing at the instance's public IP.
APP_HOST=app.recosa.eu
ADMIN_HOST=admin.recosa.eu
QUIZ_HOST=check.recosa.eu
API_HOST=api.recosa.eu
ACME_EMAIL=
# Who may open the admin back-office, space-separated CIDRs. The default lets
# everyone through to the app's own admin login; narrow it to your office or
# home address once known (e.g. "203.0.113.7/32").
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0

# ── Images (pin; change one at a time, like requirements.txt) ────────────
# Qdrant: the SAME version the Qdrant Cloud cluster runs today (Qdrant Cloud
# console → cluster → version), e.g. v1.19.0, so the collection moves across
# without a format change. Upgrade later, separately.
QDRANT_IMAGE_TAG=
CADDY_IMAGE_TAG=2.10

# ── What the apps read (same names as the Streamlit Cloud secrets) ───────
APP_BASE_URL=https://app.recosa.eu
# Supabase: the PUBLIC API URL, and the two keys supabase_env.py prints.
SUPABASE_URL=https://api.recosa.eu
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
# Qdrant: the container on the internal network. Choose a long random key.
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=
# Copy these from the Streamlit Cloud secrets unchanged.
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=
CBEAPI_KEY=
REGISTRY_BE_PROVIDER=
PRIVACY_POLICY_URL=
NOTIFY_ENABLED=
FEEDBACK_MODE=
AUDIT_IP_LIMIT=
AUDIT_IP_WINDOW_HOURS=
SUPERSEDED_RETENTION_YEARS=

# ── [supabase] Auth emails (sign-up confirmation, password reset) ────────
# Brevo's SMTP relay: Brevo → SMTP & API → SMTP tab gives the login and lets
# you create an SMTP key (not the same thing as BREVO_API_KEY).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=RECOSA
# Copy from the current project: Supabase dashboard → Authentication →
# Sign In / Providers → Email → "Confirm email". true = no confirmation.
ENABLE_EMAIL_AUTOCONFIRM=false

# ── Backups to Scaleway Object Storage (backup.sh) ───────────────────────
# A bucket in fr-par, and an API key limited to Object Storage.
BACKUP_BUCKET=
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_REGION=fr-par
